{
  "name": "forensic-vn",
  "version": "0.0.1",
  "description": "Terminal-style desktop app to learn digital forensics",
  "author": "Johan Alfaro",
  "main": "./out/main/index.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^26.0.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "dev.johanalfaro.forensicvn",
    "productName": "ForensicVN",
    "directories": { "output": "release" },
    "files": ["out/**/*", "content/**/*", "evidence/**/*", "package.json"],
    "asarUnpack": ["node_modules/node-pty/**/*"],
    "win": { "target": ["nsis"], "artifactName": "ForensicVN-${version}-Setup.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
